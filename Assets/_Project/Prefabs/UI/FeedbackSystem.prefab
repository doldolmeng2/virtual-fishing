--- !u!114 &8631416207550898152
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2300390042483693464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96f5ca31769c4f043bb79e168c3eb752, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VirtualFishing.Feedback.TTSManager
  audioSource: {fileID: 0}
  ttsList:
  - textMessage: "\uD658\uACBD \uC124\uC815\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uB09A\uC2DC\uB97C \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: f45343008b1244f948f4fdab4f166949, type: 3}
  - textMessage: "\uCEE8\uD2B8\uB864\uB7EC \uC5F0\uACB0\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 7321ea559ded5409db12aebd774df8d3, type: 3}
  - textMessage: "\uBB3C\uACE0\uAE30\uAC00 \uB3C4\uB9DD\uAC14\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 27468945fcd4b425783172c62d017572, type: 3}
  - textMessage: "\uCD95\uD558\uD569\uB2C8\uB2E4! \uBB3C\uACE0\uAE30\uB97C \uB09A\uC73C\uC168\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: c3cd13e8a31fc4e1ba010482ef5c58ca, type: 3}
  - textMessage: "\uC774\uB3D9\uD558\uC2DC\uBA74 \uC704\uD5D8\uD569\uB2C8\uB2E4.
      \uAC00\uC6B4\uB370\uB85C \uB3CC\uC544\uAC00\uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 7dda0bb5a8267418faf7edb16ef1bf1d, type: 3}
  - textMessage: "\uC548\uC804\uC744 \uC704\uD574 \uAC8C\uC784\uC744 \uBA48\uCDA5\uB2C8\uB2E4.
      \uC7A5\uBE44\uB97C \uBC97\uACE0 \uC8FC\uBCC0\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 647a73b1949a6423ca36cafbd9a09849, type: 3}
  - textMessage: "\uD798\uC744 \uBC84\uD2F0\uC9C0 \uBABB\uD558\uACE0 \uB09A\uC2EF\uC904\uC774
      \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: e173276cedc45d944b278aade29cdad8, type: 3}
  - textMessage: "\uC904\uC774 \uB108\uBB34 \uB290\uC2A8\uD574\uC838\uC11C \uBB3C\uACE0\uAE30\uAC00
      \uB3C4\uB9DD\uAC14\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: a5d3c923e80108b4ba3cf161eeec5bcf, type: 3}
  - textMessage: "\uD658\uACBD \uC124\uC815\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uCEE8\uD2B8\uB864\uB7EC\uB97C \uC6C0\uC9C1\uC5EC \uB09A\uC2EF\uB300\uC5D0
      \uB450\uACE0 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB09A\uC2EF\uB300\uB97C \uC7A1\uC544\uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 83fc5c7270ef94aa3b83103ad5180fdc, type: 3}
  - textMessage: "\uB09A\uC2EF\uB300\uB97C \uC7A1\uC558\uC2B5\uB2C8\uB2E4. \uCEE8\uD2B8\uB864\uB7EC\uB97C
      \uAF49 \uC950\uACE0 \uC55E\uC73C\uB85C \uD798\uAECF \uD718\uB458\uB7EC \uCC0C\uB97C
      \uB358\uC838\uBCF4\uC138\uC694."
    clip: {fileID: 8300000, guid: a00716cbf47fc4e3493ce8530100dea2, type: 3}
